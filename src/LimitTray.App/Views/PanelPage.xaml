<UserControl x:Class="LimitTray.App.Views.PanelPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LimitTray.App.ViewModels"
             xmlns:local="clr-namespace:LimitTray.App.Views"
             Width="328" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <local:PercentToArcConverter x:Key="PercentToArc" />
        <local:PercentToWidthConverter x:Key="PercentToWidth" />
        <local:NullableToVisibilityConverter x:Key="NullableVisibility" />
        <local:BooleanToVisibilityConverter x:Key="BooleanVisibility" />

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource CardHoverBorderBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="WindowRowTemplate" DataType="{x:Type vm:WindowRowViewModel}">
            <StackPanel Margin="0,3,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="38" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                               Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                    <Border x:Name="BarTrack" Grid.Column="1" Height="6" Margin="4,0,8,0"
                            Background="{DynamicResource TrackBrush}" CornerRadius="3"
                            VerticalAlignment="Center" ClipToBounds="True">
                        <Border Height="6" HorizontalAlignment="Left" CornerRadius="3"
                                Background="{Binding Colour}"
                                TargetUpdated="OnBarTargetUpdated">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource PercentToWidth}"
                                              NotifyOnTargetUpdated="True">
                                    <Binding ElementName="BarTrack" Path="ActualWidth" />
                                    <Binding Path="Percent" />
                                </MultiBinding>
                            </Border.Width>
                        </Border>
                    </Border>
                    <TextBlock Grid.Column="2" Text="{Binding PercentText}" TextAlignment="Right"
                               Foreground="{Binding Colour}" Typography.NumeralAlignment="Tabular"
                               VerticalAlignment="Center" />
                </Grid>
                <Canvas Height="24" Margin="56,4,38,0" ClipToBounds="True"
                        Visibility="{Binding SparklinePoints, Converter={StaticResource NullableVisibility}}">
                    <Polyline Points="{Binding SparklinePoints}" Stroke="{Binding Colour}"
                              StrokeThickness="1.5" StrokeLineJoin="Round" />
                </Canvas>
                <TextBlock Text="{Binding BurnRateText}" Margin="56,2,38,0"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Visibility="{Binding BurnRateText, Converter={StaticResource NullableVisibility}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ProviderCardViewModel}">
            <Border Margin="0,0,0,10" Padding="12" CornerRadius="14"
                    BorderThickness="1" MouseLeftButtonUp="OnCardMouseLeftButtonUp">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                        <Setter Property="Opacity" Value="1" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource CardHoverBorderBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsStale}" Value="True">
                                <Setter Property="Opacity" Value="0.55" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="52" Height="52" VerticalAlignment="Top">
                        <Ellipse Width="52" Height="52" Stroke="{DynamicResource TrackBrush}"
                                 StrokeThickness="4" />
                        <Path Data="{Binding RingPercent, Converter={StaticResource PercentToArc},
                                      NotifyOnTargetUpdated=True}"
                              Stroke="{Binding RingColour}" StrokeThickness="4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              TargetUpdated="OnRingTargetUpdated" />
                        <TextBlock Text="{Binding RingPercentText}"
                                   Foreground="{Binding RingColour}" FontSize="12"
                                   Typography.NumeralAlignment="Tabular" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding RingPercentText, Converter={StaticResource NullableVisibility}}" />
                    </Grid>

                    <Grid Grid.Column="1" Margin="8,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrush}"
                                       FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ResetShortText}" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                        </Grid>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Rows}"
                                      ItemTemplate="{StaticResource WindowRowTemplate}">
                            <ItemsControl.Visibility>
                                <Binding Path="HasData" Converter="{StaticResource BooleanVisibility}" />
                            </ItemsControl.Visibility>
                        </ItemsControl>
                        <TextBlock Grid.Row="1" Text="{Binding HealthText}" Foreground="{Binding RingColour}"
                                   Margin="0,8,0,4" Visibility="{Binding HealthText, Converter={StaticResource NullableVisibility}}" />
                        <StackPanel Grid.Row="2" Margin="0,7,0,0"
                                    Visibility="{Binding IsExpanded, Converter={StaticResource BooleanVisibility}}">
                            <TextBlock Text="{Binding LastUpdatedText}" Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="11" />
                            <TextBlock Text="{Binding TerminalError}" Foreground="{Binding RingColour}"
                                       Margin="0,3,0,0" Visibility="{Binding TerminalError, Converter={StaticResource NullableVisibility}}" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="{DynamicResource CardBrush}" CornerRadius="4">
                        <Button Content="{Binding OpenTerminalGlyph}" ToolTip="{Binding OpenTerminalText}"
                                Command="{Binding OpenTerminalCommand}"
                                Style="{StaticResource IconButtonStyle}" FontSize="14"
                                Padding="3,0">
                            <Button.Visibility>
                                <Binding Path="IsMouseOver" Converter="{StaticResource BooleanVisibility}">
                                    <Binding.RelativeSource>
                                        <RelativeSource Mode="FindAncestor" AncestorType="Border" AncestorLevel="2" />
                                    </Binding.RelativeSource>
                                </Binding>
                            </Button.Visibility>
                        </Button>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBlock Text="LIM'IT" Foreground="{DynamicResource TextBrush}"
                           FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding RefreshGlyph}" ToolTip="{Binding RefreshText}"
                        Command="{Binding RefreshCommand}"
                        RenderTransformOrigin="0.5,0.5">
                    <Button.RenderTransform>
                        <RotateTransform />
                    </Button.RenderTransform>
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRefreshing}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                                 To="360" Duration="0:0:0.6" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{Binding SettingsGlyph}" ToolTip="{Binding SettingsText}"
                        Command="{Binding SettingsCommand}" Style="{StaticResource IconButtonStyle}" />
            </StackPanel>
        </DockPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Cards}" />
        </ScrollViewer>
        <DockPanel Grid.Row="2" Margin="2,4,2,0">
            <TextBlock Text="{Binding FooterText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
            <TextBlock Text="{Binding VersionText}" DockPanel.Dock="Right"
                       Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
        </DockPanel>
    </Grid>
</UserControl>
