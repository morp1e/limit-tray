<UserControl x:Class="LimitTray.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LimitTray.App.ViewModels"
             xmlns:local="clr-namespace:LimitTray.App.Views"
             Width="328" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource CardHoverBorderBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SegmentItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#24FFFFFF" />
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SegmentStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="32" Height="18" CornerRadius="9"
                                Background="{DynamicResource TrackBrush}">
                            <Ellipse x:Name="Thumb" Width="14" Height="14" Margin="2"
                                     HorizontalAlignment="Left"
                                     Fill="{DynamicResource MutedTextBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background"
                                        Value="{DynamicResource CardHoverBorderBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SegmentTemplate">
            <TextBlock Text="{Binding Label}" />
        </DataTemplate>

        <local:BooleanToVisibilityConverter x:Key="BooleanVisibility" />

        <Style x:Key="GroupHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,4,0,2" />
            <Setter Property="Typography.Capitals" Value="SmallCaps" />
        </Style>

        <Style x:Key="SettingRowStyle" TargetType="Grid">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Margin" Value="0,2,0,2" />
        </Style>

        <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,14,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button Content="{Binding BackGlyph}" Command="{Binding BackCommand}"
                    Style="{StaticResource IconButtonStyle}" DockPanel.Dock="Left" />
            <TextBlock Text="{Binding SettingsText}" Foreground="{DynamicResource TextBrush}"
                       FontSize="18" FontWeight="Bold" VerticalAlignment="Center"
                       Margin="4,0,0,0" />
        </DockPanel>

        <Border Grid.Row="1" Margin="0,0,0,10" Padding="8,5"
                Background="{DynamicResource {x:Static SystemColors.InfoBrushKey}}"
                Visibility="{Binding SaveFailedText, Converter={x:Static local:NullableVisibilityConverter.Instance}}">
            <TextBlock Text="{Binding SaveFailedText}"
                       Foreground="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}" />
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding AppearanceGroupText}" Style="{StaticResource GroupHeaderStyle}" />
        <StackPanel Grid.Row="3" Margin="0,2,0,10">
            <Grid Style="{StaticResource SettingRowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ThemeText}" Style="{StaticResource SettingLabelStyle}" />
                <ListBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}"
                         ItemTemplate="{StaticResource SegmentTemplate}"
                         ItemContainerStyle="{StaticResource SegmentItemStyle}"
                         Style="{StaticResource SegmentStyle}" SelectedValuePath="Value"
                         SelectedValue="{Binding Theme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <Grid Style="{StaticResource SettingRowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding LanguageText}" Style="{StaticResource SettingLabelStyle}" />
                <ListBox Grid.Column="1" ItemsSource="{Binding LanguageOptions}"
                         ItemTemplate="{StaticResource SegmentTemplate}"
                         ItemContainerStyle="{StaticResource SegmentItemStyle}"
                         Style="{StaticResource SegmentStyle}" SelectedValuePath="Value"
                         SelectedValue="{Binding Language, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <Grid Style="{StaticResource SettingRowStyle}"
                  Visibility="{Binding GlassEffectVisible, Converter={StaticResource BooleanVisibility}}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding GlassEffectText}" Style="{StaticResource SettingLabelStyle}" />
                <CheckBox Grid.Column="1" Style="{StaticResource ToggleStyle}"
                          IsChecked="{Binding GlassEffect, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </StackPanel>

        <TextBlock Grid.Row="4" Text="{Binding DataGroupText}" Style="{StaticResource GroupHeaderStyle}" />
        <StackPanel Grid.Row="5" Margin="0,2,0,10">
            <Grid Style="{StaticResource SettingRowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding RefreshIntervalText}" Style="{StaticResource SettingLabelStyle}" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding RefreshOptions}" DisplayMemberPath="Label"
                          SelectedValuePath="Value" SelectedValue="{Binding RefreshSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <Grid Style="{StaticResource SettingRowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding CautionThresholdText}" Style="{StaticResource SettingLabelStyle}" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding CautionOptions}" DisplayMemberPath="Label"
                          SelectedValuePath="Value" SelectedValue="{Binding CautionThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <Grid Style="{StaticResource SettingRowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding WarningThresholdText}" Style="{StaticResource SettingLabelStyle}" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding WarningOptions}" DisplayMemberPath="Label"
                          SelectedValuePath="Value" SelectedValue="{Binding WarningThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <Grid Style="{StaticResource SettingRowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding NotificationsText}" Style="{StaticResource SettingLabelStyle}" />
                <CheckBox Grid.Column="1" Style="{StaticResource ToggleStyle}"
                          IsChecked="{Binding Notifications, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </StackPanel>

        <TextBlock Grid.Row="6" Text="{Binding TrayGroupText}" Style="{StaticResource GroupHeaderStyle}" />
        <StackPanel Grid.Row="7" Margin="0,2,0,10">
            <Grid Style="{StaticResource SettingRowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding TrayStyleText}" Style="{StaticResource SettingLabelStyle}" />
                <ListBox Grid.Column="1" ItemsSource="{Binding TrayStyleOptions}"
                         ItemTemplate="{StaticResource SegmentTemplate}"
                         ItemContainerStyle="{StaticResource SegmentItemStyle}"
                         Style="{StaticResource SegmentStyle}" SelectedValuePath="Value"
                         SelectedValue="{Binding TrayStyle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <Grid Style="{StaticResource SettingRowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding TraySourceText}" Style="{StaticResource SettingLabelStyle}" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding TraySourceOptions}" DisplayMemberPath="Label"
                          SelectedValuePath="Value" SelectedValue="{Binding TraySource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="8" Margin="0,0,0,8">
            <TextBlock Text="{Binding SystemGroupText}" Style="{StaticResource GroupHeaderStyle}" />
            <Grid Style="{StaticResource SettingRowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StartWithWindowsText}" Style="{StaticResource SettingLabelStyle}" />
                <CheckBox Grid.Column="1" Style="{StaticResource ToggleStyle}"
                          IsChecked="{Binding StartWithWindows, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </StackPanel>

        <DockPanel Grid.Row="9" Margin="2,2,2,0">
            <Button Content="{Binding BackText}" Command="{Binding BackCommand}"
                    Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Left" />
            <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                       VerticalAlignment="Center">
                <!-- Run.Text binds TwoWay by default and VersionText is read-only; a default
                     binding here threw at first layout and took the process down. -->
                <Run Text="{Binding VersionText, Mode=OneWay}" />
                <Run Text=" &#x00B7; " />
                <Hyperlink NavigateUri="{Binding GitHubUrl}" RequestNavigate="OnGitHubRequestNavigate">GitHub</Hyperlink>
            </TextBlock>
        </DockPanel>
    </Grid>
</UserControl>
