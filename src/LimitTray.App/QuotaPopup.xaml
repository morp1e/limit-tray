<Window x:Class="LimitTray.App.QuotaPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Lim'it" Width="360" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" Background="Transparent"
        FontFamily="{StaticResource AppFont}" UseLayoutRounding="True"
        SnapsToDevicePixels="True" Deactivated="OnDeactivated">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="-1" CaptionHeight="0" CornerRadius="12"
                             UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border x:Name="RootBorder" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1" CornerRadius="12">
        <Grid ClipToBounds="True">
            <ContentPresenter x:Name="PanelHost" />
            <ContentPresenter x:Name="SettingsHost" Visibility="Collapsed"
                              RenderTransformOrigin="0.5,0.5" />
        </Grid>
    </Border>
</Window>
