<Window x:Class="LimitTray.App.QuotaPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lim'it" Width="360" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" Background="{DynamicResource SurfaceBrush}"
        FontFamily="{StaticResource AppFont}" UseLayoutRounding="True"
        SnapsToDevicePixels="True" Deactivated="OnDeactivated">
    <!--
        No WindowChrome: with GlassFrameThickness it drew a light DWM frame and squared the
        corners. Rounding and the missing border line come from DWM attributes set in
        WindowBackdrop, so this tree only has to paint the surface and the two brand glows
        the mockup had.
    -->
    <!--
        The surface is painted edge to edge with square corners. Windows 11 rounds the
        window itself (DWM corner preference, about 8 px); painting our own 12 px radius
        underneath left a black crescent between the two curves. Windows 10 shows the
        square corners as they are.
    -->
    <Border x:Name="RootBorder" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1" CornerRadius="0">
        <Grid ClipToBounds="True">
            <!-- Brand glows: painted from Palette in code-behind, never hex in XAML. -->
            <Ellipse x:Name="GlowTopLeft" Width="420" Height="300" IsHitTestVisible="False"
                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-190,-160,0,0" />
            <Ellipse x:Name="GlowBottomRight" Width="380" Height="280" IsHitTestVisible="False"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-170,-150" />
            <ContentPresenter x:Name="PanelHost" />
            <ContentPresenter x:Name="SettingsHost" Visibility="Collapsed"
                              RenderTransformOrigin="0.5,0.5" />
        </Grid>
    </Border>
</Window>
